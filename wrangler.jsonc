{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oneclick-chatgpt",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "oneclickwebsitedesignfactory.com/oneclick-chatgpt-plugin/*", "zone_name": "oneclickwebsitedesignfactory.com" }],
  "observability": { "enabled": true },
  "vars": {
    "ONECLICK_SITE_URL": "https://oneclickwebsitedesignfactory.com"
  },
  "analytics_engine_datasets": [
    { "binding": "ONECLICK_ANALYTICS", "dataset": "oneclick_usage" }
  ]
}
