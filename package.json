{
  "name": "oneclick-chatgpt-plugin",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "description": "Turn bounded website requirements into a structured Lovable handoff from ChatGPT.",
  "scripts": {
    "assets": "node scripts/generate-logo.mjs",
    "lint": "node scripts/check-source.mjs",
    "test": "node --test",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "check": "npm run build:native && npm run lint && npm test && npm run validate:plugin",
    "types": "npx --yes wrangler@4.33.1 types",
    "dev": "npx --yes wrangler@4.33.1 dev",
    "deploy": "npx --yes wrangler@4.33.1 deploy",
    "deploy:dry": "npx --yes wrangler@4.33.1 deploy --dry-run",
    "smoke:production": "node scripts/smoke-production.mjs",
    "smoke:information-pages": "node scripts/smoke-information-pages.mjs",
    "verify:privacy": "node scripts/verify-production-privacy.mjs",
    "evidence:production": "node scripts/record-review-evidence.mjs",
    "build:native": "node scripts/build-native.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "27.3.0"
  },
  "dependencies": {
    "@better-auth/mcp": "1.7.7",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/server": "2.0.0",
    "@openai/mcp-extensions": "0.1.0",
    "zod": "4.4.3"
  }
}
