{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oneclick-chatgpt",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ONECLICK_SITE_URL": "https://oneclickwebsitedesignfactory.com",
    "ONECLICK_BACKEND_URL": "https://oneclickwebsitedesignfactory.com",
    "ONECLICK_NATIVE_ENABLED": "false",
    "ONECLICK_FULL_MODE_READY": "false",
    "OPENAI_APPS_CHALLENGE": "bJOv4gQj_Xtt3yRg5qxnyPnyL3GNmIWTpJV5qNIq7hg",
    "SOURCE_REVISION": "set-to-accepted-commit"
  },
  "analytics_engine_datasets": [
    {
      "binding": "ONECLICK_ANALYTICS",
      "dataset": "oneclick_usage"
    }
  ],
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false
    }
  },
  "logpush": false
}
